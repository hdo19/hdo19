rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isNotBanned() {
      return signedIn() && !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /tutorials/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isNotBanned()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.articleId is string
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.author.size() <= 45
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create: if isNotBanned()
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.articleId + '_' + request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /bannedUsers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
